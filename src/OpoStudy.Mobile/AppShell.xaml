<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OpoStudy.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OpoStudy.Mobile.Views"
    Title="OpoStudy"
    FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False">

    <!-- Top-level pages (absolute navigation, no way back to login). register and forgot-password
         are registered in code and pushed on top of login. The styleguide route is DEBUG only. -->
    <ShellContent
        Title="OpoStudy"
        ContentTemplate="{DataTemplate views:StartupPage}"
        Route="startup" />
    <ShellContent
        Title="Iniciar sesión"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />
    <ShellContent
        Title="OpoStudy"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="home" />

</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage
    x:Class="OpoStudy.Mobile.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OpoStudy.Mobile.Views"
    xmlns:vm="clr-namespace:OpoStudy.Mobile.Core.ViewModels;assembly=OpoStudy.Mobile.Core"
    x:DataType="vm:RegisterViewModel"
    Title="Crear cuenta">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">

            <Label
                Style="{StaticResource TitleLabel}"
                Text="Crear cuenta"
                SemanticProperties.HeadingLevel="Level1" />

            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                <Label Text="Correo electrónico" />
                <Entry
                    Keyboard="Email"
                    Text="{Binding Email}"
                    ReturnType="Next"
                    SemanticProperties.Description="Correo electrónico" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                <Label Text="Contraseña" />
                <Entry
                    IsPassword="True"
                    Text="{Binding Password}"
                    ReturnType="Next"
                    SemanticProperties.Description="Contraseña" />
                <Label Style="{StaticResource CaptionLabel}" Text="Al menos 6 caracteres" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                <Label Text="Repetir contraseña" />
                <Entry
                    IsPassword="True"
                    Text="{Binding ConfirmPassword}"
                    ReturnType="Done"
                    ReturnCommand="{Binding RegisterCommand}"
                    SemanticProperties.Description="Repetir contraseña" />
            </VerticalStackLayout>

            <Label
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}" />

            <Button Text="Crear cuenta" Command="{Binding RegisterCommand}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                SemanticProperties.Description="Creando la cuenta" />
        </VerticalStackLayout>
    </ScrollView>
</views:ViewModelPage>

<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage
    x:Class="OpoStudy.Mobile.Views.PracticalCasePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OpoStudy.Mobile.Views"
    xmlns:controls="clr-namespace:OpoStudy.Mobile.Views.Controls"
    xmlns:texts="clr-namespace:OpoStudy.Mobile.Core.PracticalCases;assembly=OpoStudy.Mobile.Core"
    xmlns:vm="clr-namespace:OpoStudy.Mobile.Core.ViewModels;assembly=OpoStudy.Mobile.Core"
    x:DataType="vm:PracticalCaseViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">

                <controls:OfflineBanner IsVisible="{Binding ShowOfflineBanner}" Text="{Binding OfflineBannerText}" />

                <HorizontalStackLayout Spacing="{StaticResource SpaceM}" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                    <Label Text="Cargando supuesto…" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceM}" IsVisible="{Binding NeedsConnection}">
                    <Label Style="{StaticResource WarningLabel}" Text="{x:Static texts:PracticalCaseTexts.NeedsConnection}" />
                    <Button Text="Reintentar" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceM}" IsVisible="{Binding HasLoadError}">
                    <Label Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
                    <Button Text="Reintentar" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{StaticResource SpaceL}" IsVisible="{Binding IsLoaded}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label
                            Style="{StaticResource TitleLabel}"
                            Text="{Binding Title}"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding Header}" />
                    </VerticalStackLayout>

                    <Border>
                        <Label Text="{Binding Statement}" />
                    </Border>

                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="{Binding DraftNotice}"
                        IsVisible="{Binding HasDraftNotice}" />

                    <!--
                        BindableLayout instead of CollectionView (exception to the list rule): a case has at most 8 parts and
                        each one holds an Editor that grows with its text, which CollectionView recycling handles badly.
                    -->
                    <VerticalStackLayout Spacing="{StaticResource SpaceXl}" BindableLayout.ItemsSource="{Binding Parts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PracticalCasePartItem">
                                <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                                    <Label
                                        Style="{StaticResource SubtitleLabel}"
                                        Text="{Binding Title}"
                                        SemanticProperties.HeadingLevel="Level2" />
                                    <Label Text="{Binding Statement}" />
                                    <Border Padding="{StaticResource SpaceS}">
                                        <Editor
                                            Style="{StaticResource AnswerEditorStyle}"
                                            Text="{Binding Answer}"
                                            MaxLength="{x:Static texts:PracticalCaseLimits.AnswerMaxLength}"
                                            AutoSize="TextChanges"
                                            Placeholder="Escribe tu respuesta"
                                            SemanticProperties.Description="{Binding Title}" />
                                    </Border>
                                    <Label
                                        Style="{StaticResource CaptionLabel}"
                                        HorizontalOptions="End"
                                        Text="{Binding CharacterCountText}"
                                        IsVisible="{Binding IsNotNearLimit}" />
                                    <Label
                                        Style="{StaticResource WarningLabel}"
                                        HorizontalOptions="End"
                                        Text="{Binding CharacterCountText}"
                                        IsVisible="{Binding IsNearLimit}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed bottom bar: messages, quota and submit. -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                <Label Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <Label Style="{StaticResource WarningLabel}" Text="{Binding QuotaMessage}" IsVisible="{Binding HasQuotaMessage}" />
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding SavedNotice}" IsVisible="{Binding HasSavedNotice}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="{Binding QuotaSummary}"
                        IsVisible="{Binding HasQuota}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="Enviar a corregir"
                        Command="{Binding SubmitCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:ViewModelPage>

<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage
    x:Class="OpoStudy.Mobile.Views.TopicsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OpoStudy.Mobile.Views"
    xmlns:controls="clr-namespace:OpoStudy.Mobile.Views.Controls"
    xmlns:vm="clr-namespace:OpoStudy.Mobile.Core.ViewModels;assembly=OpoStudy.Mobile.Core"
    x:DataType="vm:TopicsViewModel"
    Title="{Binding ExamName}">

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <CollectionView
            ItemsSource="{Binding Topics}"
            Margin="{StaticResource PagePadding}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="{StaticResource SpaceM}" Padding="0,0,0,12">
                    <Label
                        Style="{StaticResource TitleLabel}"
                        Text="{Binding ExamName}"
                        SemanticProperties.HeadingLevel="Level1" />

                    <controls:OfflineBanner IsVisible="{Binding ShowOfflineBanner}" Text="{Binding OfflineBannerText}" />

                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Label Text="Preguntas por test" />
                        <Picker
                            Title="Preguntas por test"
                            ItemsSource="{Binding QuestionCountOptions}"
                            SelectedItem="{Binding SelectedQuestionCount}"
                            MinimumHeightRequest="{StaticResource MinTouchTarget}"
                            SemanticProperties.Description="Preguntas por test" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="{StaticResource SpaceM}" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" />
                        <Label Text="Cargando temas…" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource SpaceM}" IsVisible="{Binding HasError}">
                        <Label Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
                        <Button Text="Reintentar" Command="{Binding RefreshCommand}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="{StaticResource MinTouchTarget}">
                            <Label Text="Solo preguntas falladas" VerticalOptions="Center" />
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding MistakesOnly}"
                                IsEnabled="{Binding CanReviewMistakes}"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Solo preguntas falladas" />
                        </Grid>
                        <Label
                            Style="{StaticResource CaptionLabel}"
                            Text="{Binding MistakesHint}"
                            IsVisible="{Binding HasMistakesHint}" />
                    </VerticalStackLayout>

                    <Border
                        MinimumHeightRequest="{StaticResource MinTouchTarget}"
                        SemanticProperties.Description="{Binding RandomCardDescription}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRandomCardAvailable}" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartRandomQuizCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <Label Style="{StaticResource SubtitleLabel}" Text="{Binding RandomCardTitle}" />
                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding RandomCardSubtitle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="Esta oposición aún no tiene temas."
                        IsVisible="{Binding IsEmpty}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource SpaceM}" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TopicItem">
                    <Border
                        MinimumHeightRequest="{StaticResource MinTouchTarget}"
                        SemanticProperties.Description="{Binding Title}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding StartTopicQuizCommand, Source={RelativeSource AncestorType={x:Type vm:TopicsViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <Label Style="{StaticResource SubtitleLabel}" Text="{Binding Title}" />
                            <Label
                                Style="{StaticResource CaptionLabel}"
                                Text="{Binding Section}"
                                IsVisible="{Binding HasSection}" />
                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding QuestionCountText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</views:ViewModelPage>

<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage
    x:Class="OpoStudy.Mobile.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OpoStudy.Mobile.Views"
    xmlns:vm="clr-namespace:OpoStudy.Mobile.Core.ViewModels;assembly=OpoStudy.Mobile.Core"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="Recuperar contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">

            <Label
                Style="{StaticResource TitleLabel}"
                Text="Recuperar contraseña"
                SemanticProperties.HeadingLevel="Level1" />

            <VerticalStackLayout Spacing="{StaticResource SpaceL}" IsVisible="{Binding IsNotSent}">
                <Label Text="Escribe tu correo y te enviaremos un enlace para restablecer la contraseña." />

                <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                    <Label Text="Correo electrónico" />
                    <Entry
                        Keyboard="Email"
                        Text="{Binding Email}"
                        ReturnType="Done"
                        ReturnCommand="{Binding SendCommand}"
                        SemanticProperties.Description="Correo electrónico" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}" />

                <Button Text="Enviar enlace" Command="{Binding SendCommand}" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Enviando el enlace" />
            </VerticalStackLayout>

            <Label
                Style="{StaticResource SuccessLabel}"
                Text="{Binding ConfirmationMessage}"
                IsVisible="{Binding IsSent}" />
        </VerticalStackLayout>
    </ScrollView>
</views:ViewModelPage>

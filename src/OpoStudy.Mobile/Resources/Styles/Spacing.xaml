<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing scale (multiples of 4) -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <x:Double x:Key="CornerRadius">12</x:Double>
    <x:Double x:Key="MinTouchTarget">48</x:Double>
    <x:Double x:Key="DimmedOpacity">0.6</x:Double>
    <x:Double x:Key="AnswerEditorMinHeight">160</x:Double>

    <!-- Statistics: month calendar cells and the practical case bar chart -->
    <Thickness x:Key="ListHeaderPadding">0,0,0,12</Thickness>
    <Thickness x:Key="ListFooterPadding">0,12,0,0</Thickness>
    <Thickness x:Key="CalendarCellGap">2</Thickness>
    <Thickness x:Key="IndexCellMargin">4</Thickness>
    <CornerRadius x:Key="CalendarCornerRadius">8</CornerRadius>
    <x:Double x:Key="CalendarTodayStroke">2</x:Double>
    <x:Double x:Key="ChartBarAreaHeight">96</x:Double>
    <x:Double x:Key="ChartBarWidth">32</x:Double>
    <x:Double x:Key="ChartBarSlotWidth">56</x:Double>
</ResourceDictionary>

<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens as light/dark pairs. Styles combine them with AppThemeBinding.
         Contrast ratios are documented in docs/diseno/sistema-diseno.md.
         For Android see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="PrimaryLight">#1E5AA8</Color>
    <Color x:Key="PrimaryDark">#9CC2FF</Color>

    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#0B2545</Color>

    <Color x:Key="BackgroundLight">#F7F8FA</Color>
    <Color x:Key="BackgroundDark">#121417</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1D2026</Color>

    <Color x:Key="OnSurfaceLight">#1B1D21</Color>
    <Color x:Key="OnSurfaceDark">#E6E8EC</Color>

    <Color x:Key="OnSurfaceVariantLight">#4A505A</Color>
    <Color x:Key="OnSurfaceVariantDark">#B4BAC4</Color>

    <Color x:Key="OutlineLight">#C4C9D1</Color>
    <Color x:Key="OutlineDark">#3C424C</Color>

    <Color x:Key="SuccessLight">#1B7A3A</Color>
    <Color x:Key="SuccessDark">#7FD69B</Color>

    <Color x:Key="ErrorLight">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>

    <Color x:Key="WarningLight">#8A5300</Color>
    <Color x:Key="WarningDark">#FFC870</Color>
</ResourceDictionary>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpoStudy practical case",
  "description": "Un supuesto práctico con apartados, rúbrica y respuesta modelo (practical-cases/<nombre>.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "title", "statement", "estimatedMinutes", "parts"],
  "properties": {
    "$schema": { "type": "string" },
    "key": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$", "maxLength": 150 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "section": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
    "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 240 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "modelAnswer", "criteria"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
          "modelAnswer": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "points"],
              "properties": {
                "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
                "points": { "type": "integer", "minimum": 1, "maximum": 10 }
              }
            }
          }
        }
      }
    }
  }
}
